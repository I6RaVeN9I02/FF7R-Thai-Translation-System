// [อัปเกรด] เพิ่มตัวแปรชื่อ Log Sheet
const LOG_SHEET_NAME = '_HUB_LOG';

// สร้างเมนู "Hub Tools"
function onOpen() {
  SpreadsheetApp.getUi()
      .createMenu('Tier 1 Hub Tools 🏗️ (V2.3)')
      .addItem('นำเข้าจากชีตปัจจุบัน (พร้อม Log)', 'importDataFromActiveSheet_V2_3')
      .addToUi();
}

/**
 * V2.3 - Active Sheet Importer (with Logging)
 * สคริปต์นี้ "อ่าน" จากชีตที่ผู้ใช้เปิดอยู่ (Active Sheet)
 * "ข้าม 2 แถวแรก" (Row 1, Row 2)
 * และ "บันทึก Log" (Append Log) ทุกครั้งที่ทำงานสำเร็จ
 */
function importDataFromActiveSheet_V2_3() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  
  // 1. ชีตต้นทาง (ยังคงเดิม)
  const tempSheet = ss.getActiveSheet();
  const tempSheetName = tempSheet.getName();

  // 2. [ความปลอดภัย] (ยังคงเดิม)
  const protectedSheets = ['JP', 'US', 'ENJP', 'RESIDENT_JP', 'RESIDENT_US', LOG_SHEET_NAME];
  if (protectedSheets.includes(tempSheetName.toUpperCase())) {
    ui.alert(`ข้อควรระวัง!\nคุณกำลังเปิดชีต '${tempSheetName}' ซึ่งเป็นชีต "ปลายทาง" หรือ "Log"\n\nกรุณาไปที่ชีต "ต้นทาง" (Source) (เช่น _TEMP_IMPORT) ที่มีข้อมูลดิบ แล้วรันสคริปต์นี้อีกครั้งค่ะ`);
    return;
  }
  
  // 3. [อัปเกรด] (ยังคงเดิม)
  const allData = tempSheet.getDataRange().getValues();
  if (allData.length < 3) {
    ui.alert(`ชีต '${tempSheetName}' (ชีตปัจจุบัน) มีข้อมูลน้อยกว่า 3 แถว\nกรุณาวางข้อมูลดิบ (ที่เริ่มจาก A3) ก่อนรันค่ะ`);
    return;
  }
  const sourceData = allData.slice(2); 

  // 4. ถามข้อมูล (ยังคงเดิม)
  const cityCodeResponse = ui.prompt('ขั้นตอนที่ 1/3', 'กรุณาระบุ "รหัส" (เช่น 02-GL หรือ 99-RES):', ui.ButtonSet.OK_CANCEL);
  if (cityCodeResponse.getSelectedButton() !== ui.Button.OK || !cityCodeResponse.getResponseText()) return;
  const cityCode = cityCodeResponse.getResponseText().trim().toUpperCase();

  const langResponse = ui.prompt('ขั้นตอนที่ 2/3', 'ข้อมูลนี้คือภาษาอะไร? (JP, US, or ENJP):', ui.ButtonSet.OK_CANCEL);
  if (langResponse.getSelectedButton() !== ui.Button.OK || !langResponse.getResponseText()) return;
  const lang = langResponse.getResponseText().trim().toUpperCase();

  // 5. ตรรกะ "Smart Routing" (ยังคงเดิม)
  let targetSheetName = "";
  let addCityCodeColumn = true; 
  if (cityCode === '99-RES') {
    addCityCodeColumn = false; 
    if (lang === 'JP') targetSheetName = 'RESIDENT_JP';
    else if (lang === 'US') targetSheetName = 'RESIDENT_US';
  } else {
    if (lang === 'JP') targetSheetName = 'JP';
    else if (lang === 'US') targetSheetName = 'US';
    else if (lang === 'ENJP') targetSheetName = 'ENJP';
  }
  
  // 6. ตรวจสอบความถูกต้อง (ยังคงเดิม)
  if (targetSheetName === "") {
    ui.alert(`ข้อผิดพลาด!\nการจับคู่ไม่ถูกต้อง (เช่น '99-RES' กับ 'ENJP', หรือภาษาที่ไม่รู้จัก)\nกรุณาลองใหม่ค่ะ`);
    return;
  }
  const targetSheet = ss.getSheetByName(targetSheetName);
  if (!targetSheet) {
    ui.alert(`ไม่พบชีตเป้าหมาย '${targetSheetName}' ค่ะ! กรุณาสร้างชีตนี้ก่อน`);
    return;
  }

  // 7. ประมวลผลในหน่วยความจำ (ยังคงเดิม)
  let outputData = [];
  if (addCityCodeColumn) {
    outputData = sourceData.map(row => [cityCode, ...row]);
  } else {
    outputData = sourceData;
  }
  const numOutputCols = outputData[0].length;

  // 8. เขียนข้อมูลต่อท้าย (Append) (ยังคงเดิม)
  targetSheet.getRange(
    targetSheet.getLastRow() + 1, 
    1,                             
    outputData.length,             
    numOutputCols                  
  ).setValues(outputData);
  
  // --- 9. (ใหม่!) บันทึก Log การทำงาน ---
  let logSheet = ss.getSheetByName(LOG_SHEET_NAME);
  
  if (!logSheet) {
    // ถ้าไม่มีชีต Log ให้สร้างใหม่
    logSheet = ss.insertSheet(LOG_SHEET_NAME);
    // ตั้งค่าหัวข้อ (Headers)
    logSheet.appendRow([
      'Timestamp', 'City_Code_Input', 'Language_Input', 'Target_Sheet', 'Rows_Imported', 'Source_Sheet'
    ]);
    // (ตกแต่งเล็กน้อย)
    logSheet.getRange('A1:F1').setFontWeight('bold');
    logSheet.setFrozenRows(1);
    logSheet.getRange('E:E').setNumberFormat('0'); // Format แถวจำนวน
  }
  
  // บันทึก Log (Append) 1 แถว
  logSheet.appendRow([
    new Date(),           // Timestamp
    cityCode,             // City_Code_Input
    lang,                 // Language_Input
    targetSheetName,      // Target_Sheet
    sourceData.length,    // Rows_Imported
    tempSheetName         // Source_Sheet
  ]);
  
  // 10. [อัปเกรด] แจ้งเตือนผู้ใช้
  ui.alert(`สำเร็จ!\n- นำเข้า ${sourceData.length} แถว (จากชีต '${tempSheetName}')\n- ส่งไปยังชีต: ${targetSheetName}\n\n- (บันทึก Log ในชีต '${LOG_SHEET_NAME}' เรียบร้อยค่ะ)`);
}
