// --- การตั้งค่า ---
const RAW_JP_SHEET_NAME = 'JP';
const RAW_US_SHEET_NAME = 'US';
const RAW_ENJP_SHEET_NAME = 'ENJP';
const TARGET_SHEET_NAME = 'Names_JP_TH_EN';
const TEMP_JP_INDEX = 'Sherlock_JP_Index';
const TEMP_US_EVIDENCE = 'Sherlock_US_Evidence';
const TEMP_ENJP_EVIDENCE = 'Sherlock_ENJP_Evidence';
const TEMP_CASE_FILES = 'Sherlock_Case_Files';
const AUDIT_SHEET_NAME = 'AUDIT_REVIEW';
const CONFIDENCE_THRESHOLD = 60;

// --- ขั้นตอนที่ 1 และ 2 (ไม่มีการเปลี่ยนแปลง) ---
function sherlock_step1_GatherEvidence() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  const rawJPSheet = ss.getSheetByName(RAW_JP_SHEET_NAME);
  let jpIndexSheet = ss.getSheetByName(TEMP_JP_INDEX);
  if (jpIndexSheet) { jpIndexSheet.clear(); } else { jpIndexSheet = ss.insertSheet(TEMP_JP_INDEX); }
  const jpData = rawJPSheet.getRange('A:C').getValues();
  const jpResults = [['case_id', 'name_JP', '3LID', 'Full_ID']];
  let caseIdCounter = 1;
  for (const row of jpData) {
    const fullId = row[0]; const type = row[1]; const name = row[2];
    if (type === 'ACTOR' && name && fullId && !fullId.endsWith('0')) {
      const lid = fullId.slice(-3);
      const caseId = `CASE_${String(caseIdCounter++).padStart(5, '0')}`;
      jpResults.push([caseId, name, lid, fullId]);
    }
  }
  jpIndexSheet.getRange(1, 1, jpResults.length, 4).setValues(jpResults);
  createEvidenceSheet(ss, RAW_US_SHEET_NAME, TEMP_US_EVIDENCE, 'name_US');
  createEvidenceSheet(ss, RAW_ENJP_SHEET_NAME, TEMP_ENJP_EVIDENCE, 'name_ENJP_ref');
  ui.alert('ขั้นตอนที่ 1 สำเร็จ: รวบรวมหลักฐานทั้งหมดเรียบร้อยแล้วค่ะ');
}

function sherlock_step2_AnalyzeAndScoreCases() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  const jpIndexSheet = ss.getSheetByName(TEMP_JP_INDEX);
  const usEvidenceSheet = ss.getSheetByName(TEMP_US_EVIDENCE);
  const enjpEvidenceSheet = ss.getSheetByName(TEMP_ENJP_EVIDENCE);
  if (!jpIndexSheet || !usEvidenceSheet || !enjpEvidenceSheet) {
    ui.alert('กรุณารันขั้นตอนที่ 1 ก่อนค่ะ'); return;
  }
  let caseFilesSheet = ss.getSheetByName(TEMP_CASE_FILES);
  if (caseFilesSheet) { caseFilesSheet.clear(); } else { caseFilesSheet = ss.insertSheet(TEMP_CASE_FILES); }
  const usEvidenceMap = new Map(usEvidenceSheet.getDataRange().getValues());
  const enjpEvidenceMap = new Map(enjpEvidenceSheet.getDataRange().getValues());
  const jpIndexData = jpIndexSheet.getDataRange().getValues();
  jpIndexData.shift();
  const contextMap = new Map();
  for (const row of jpIndexData) {
    const caseId = row[0]; const name = row[1]; const lid = row[2]; const fullId = row[3];
    const key = `${name}|${lid}`;
    if (!contextMap.has(key)) { contextMap.set(key, []); }
    contextMap.get(key).push({ caseId, fullId });
  }
  const caseFileResults = [['Context_Key', 'Suggested_US', 'Suggested_ENJP', 'Confidence_Score', 'Status', 'Evidence_US', 'Evidence_ENJP', 'Relevant_Full_IDs']];
  for (const [contextKey, fullIdGroup] of contextMap.entries()) {
    const usCandidates = fullIdGroup.map(item => usEvidenceMap.get(item.fullId)).filter(Boolean);
    const enjpCandidates = fullIdGroup.map(item => enjpEvidenceMap.get(item.fullId)).filter(Boolean);
    const { score, bestUS, bestENJP } = computeScore(usCandidates, enjpCandidates, fullIdGroup, usEvidenceMap, enjpEvidenceMap);
    const status = score >= CONFIDENCE_THRESHOLD ? 'AUTO_ACCEPTED' : 'FLAGGED_FOR_REVIEW';
    caseFileResults.push([
      contextKey,
      bestUS,
      bestENJP,
      score,
      status,
      [...new Set(usCandidates)].join(', '),
      [...new Set(enjpCandidates)].join(', '),
      fullIdGroup.map(item => item.fullId).join(', ')
    ]);
  }
  caseFilesSheet.getRange(1, 1, caseFileResults.length, 8).setValues(caseFileResults);
  ui.alert('ขั้นตอนที่ 2 สำเร็จ: วิเคราะห์และให้คะแนนคดีทั้งหมดแล้วค่ะ');
}


// --- ขั้นตอนที่ 3 (V7.4 - Final Justice) ---
function sherlock_step3_PresentFinalReport_V7_4() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  const targetSheet = ss.getSheetByName(TARGET_SHEET_NAME);
  const caseFilesSheet = ss.getSheetByName(TEMP_CASE_FILES);
  if (!caseFilesSheet) { ui.alert('กรุณารันขั้นตอนที่ 2 ก่อนค่ะ'); return; }

  const caseFilesData = caseFilesSheet.getDataRange().getValues();
  caseFilesData.shift();

  const finalReport = [['name_JP', '3LID', 'name_US', 'name_ENJP_ref']];
  const auditReport = [['Status', 'name_JP', '3LID', 'Confidence_Score', 'Suggested_US', 'Suggested_ENJP', 'Evidence_US', 'Evidence_ENJP', 'Relevant_Full_IDs']];
  
  const masterListMap = new Map();
  caseFilesData.forEach(row => {
      const contextKey = row[0];
      if (!masterListMap.has(contextKey)) {
          masterListMap.set(contextKey, { name: contextKey.split('|')[0], lid: contextKey.split('|')[1] });
      }
  });

  const masterList = Array.from(masterListMap.values()).sort((a, b) => a.lid.localeCompare(b.lid) || a.name.localeCompare(b.name));

  for (const item of masterList) {
    const contextKey = `${item.name}|${item.lid}`;
    const caseFile = caseFilesData.find(row => row[0] === contextKey);
    const [_, suggestedUS_old, suggestedENJP_old, score, status, evidenceUS, evidenceENJP, relevantIDs] = caseFile;

    // --- ตรรกะที่แยกการทำงานของ US และ ENJP ออกจากกันอย่างสมบูรณ์ ---
    
    // 1. ตรรกะสำหรับคอลัมน์ US (ซับซ้อนและมี Fallback)
    const usCandidatesList = evidenceUS ? [...new Set(evidenceUS.split(', '))] : [];
    let finalUS = '';
    if (usCandidatesList.length > 0) {
      finalUS = usCandidatesList.join(', ');
    } else {
      const enjpForFallback = evidenceENJP ? evidenceENJP.split(', ') : [];
      finalUS = getMostFrequentString(enjpForFallback);
    }
    
    // 2. ตรรกะสำหรับคอลัมน์ ENJP (เรียบง่ายและตรงไปตรงมา)
    const enjpCandidatesList = evidenceENJP ? evidenceENJP.split(', ') : [];
    const finalENJP = getMostFrequentString(enjpCandidatesList);

    finalReport.push([item.name, item.lid, finalUS, finalENJP]);

    // การสร้าง Audit Report ยังคงเหมือนเดิม
    if (status === 'FLAGGED_FOR_REVIEW') {
      auditReport.push([status, item.name, item.lid, score, suggestedUS_old, suggestedENJP_old, evidenceUS, evidenceENJP, relevantIDs]);
    }
  }

  // --- การเขียนผลลัพธ์ ---
  targetSheet.getRange('H:K').clearContent();
  targetSheet.getRange(1, 8, finalReport.length, 4).setValues(finalReport);

  let auditSheet = ss.getSheetByName(AUDIT_SHEET_NAME);
  if (auditSheet) { auditSheet.clear(); } else { auditSheet = ss.insertSheet(AUDIT_SHEET_NAME); }
  
  if (auditReport.length > 1) {
    auditSheet.getRange(1, 1, auditReport.length, 9).setValues(auditReport);
    ui.alert(`ขั้นตอนที่ 3 (Final Justice) สำเร็จ!\n- อัปเดตผลลัพธ์ใน '${TARGET_SHEET_NAME}'\n- สร้างแฟ้มคดีสำหรับตรวจสอบใน '${AUDIT_SHEET_NAME}' จำนวน ${auditReport.length - 1} รายการค่ะ`);
  } else {
    if(auditSheet) { ss.deleteSheet(auditSheet); }
    ui.alert(`ขั้นตอนที่ 3 (Final Justice) สำเร็จ!\n- อัปเดตผลลัพธ์ใน '${TARGET_SHEET_NAME}'\n- ไม่พบรายการที่ต้องตรวจสอบเพิ่มเติมค่ะ`);
  }
}


// --- ฟังก์ชันเสริมและฟังก์ชันอื่นๆ ทั้งหมด (ไม่มีการเปลี่ยนแปลง) ---
function sherlock_cleanupSmart() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  const sheetsToDelete = [TEMP_JP_INDEX, TEMP_US_EVIDENCE, TEMP_ENJP_EVIDENCE];
  sheetsToDelete.forEach(name => {
    const sheet = ss.getSheetByName(name);
    if (sheet) { ss.deleteSheet(sheet); }
  });
  const caseFilesSheet = ss.getSheetByName(TEMP_CASE_FILES);
  if (caseFilesSheet) {
    caseFilesSheet.deleteColumn(8); 
  }
  ui.alert('ล้างข้อมูลสำเร็จ!\n- ลบชีต Index และ Evidence\n- เก็บแฟ้มคดีและรายการตรวจสอบไว้\n- ลบคอลัมน์ Full IDs ที่ไม่จำเป็นออกจากแฟ้มคดีแล้วค่ะ');
}

function createEvidenceSheet(ss, sourceName, targetName, headerName) {
  const sourceSheet = ss.getSheetByName(sourceName);
  let targetSheet = ss.getSheetByName(targetName);
  if (targetSheet) { targetSheet.clear(); }
  else { targetSheet = ss.insertSheet(targetName); }
  const data = sourceSheet.getRange('A:C').getValues();
  const results = [['Full_ID', headerName]];
  for (const row of data) {
    const fullId = row[0]; const type = row[1]; const name = row[2];
    if (type === 'ACTOR' && name && fullId) {
      results.push([fullId, name]);
    }
  }
  targetSheet.getRange(1, 1, results.length, 2).setValues(results);
}

function computeScore(usCandidates, enjpCandidates, fullIdGroup, usEvidenceMap, enjpEvidenceMap) {
  let score = 0;
  let bestUS = getMostFrequentString(usCandidates);
  let bestENJP = getMostFrequentString(enjpCandidates);
  if (usCandidates.length === 1 && new Set(usCandidates).size === 1) {
    score += 50;
  }
  for (const item of fullIdGroup) {
    const usName = usEvidenceMap.get(item.fullId);
    if (usName && usName === bestUS) { score += 20; }
    const enjpName = enjpEvidenceMap.get(item.fullId);
    if (enjpName && enjpName === bestENJP) { score += 10; }
    if (usName && enjpName && usName === enjpName) {
      score += 30;
      bestUS = usName;
      break;
    }
  }
  if (new Set(usCandidates).size > 1) { score -= 30; }
  if (!bestUS && bestENJP) {
    bestUS = bestENJP;
    score += 15;
  }
  return { score: Math.max(0, score), bestUS, bestENJP };
}

function getMostFrequentString(arr) {
  if (!arr || arr.length === 0) return '';
  const frequencyMap = arr.reduce((acc, val) => { acc[val] = (acc[val] || 0) + 1; return acc; }, {});
  return Object.keys(frequencyMap).reduce((a, b) => frequencyMap[a] > frequencyMap[b] ? a : b);
}
