/**
 * ฟังก์ชันพิเศษ: สร้างเมนูสำหรับ "Project Sherlock" (V7.4)
 */
function onOpen() {
  SpreadsheetApp.getUi()
      .createMenu('Project Sherlock 🕵️ (V7.4)')
      .addItem('ขั้นตอนที่ 1: รวบรวมหลักฐาน', 'sherlock_step1_GatherEvidence')
      .addItem('ขั้นตอนที่ 2: วิเคราะห์และให้คะแนน', 'sherlock_step2_AnalyzeAndScoreCases')
      .addSeparator()
      .addItem('ขั้นตอนที่ 3: สรุปผล (Final Justice)', 'sherlock_step3_PresentFinalReport_V7_4')
      .addSeparator()
      .addItem('ล้างข้อมูล (เก็บแฟ้มคดีไว้)', 'sherlock_cleanupSmart')
      .addToUi();
