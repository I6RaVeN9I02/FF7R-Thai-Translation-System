 * -------------------------------------------
 */

/**
 * (V1.0) "ฟังก์ชันฉีดสูตร"
 * (ss = ชีต Template V3 ที่ผู้ใช้กำลังเปิดอยู่)
 * (formulaKey = รหัสสูตรที่ผู้ใช้เลือก เช่น "QST_V1_FORMULA")
 */
function runFormulaInjection(ss, formulaKey) {
  Logger.log(`[Formula Migrator] รับคำสั่งฉีดสูตร: ${formulaKey}`);
  
  try {
    // 1. ไปดึง "พิมพ์เขียว" มาจากคลังส่วนกลาง
    const formulaMap = getCentralFormulaMap_(); 
    const blueprint = formulaMap.get(formulaKey);

    if (!blueprint) {
      Logger.log(`ไม่พบพิมพ์เขียวสูตร: ${formulaKey}`);
      return { success: false, error: "ไม่พบพิมพ์เขียวสูตร: " + formulaKey };
    }

    // 2. ค้นหา "ชีตเป้าหมาย" (ใน Template V3 ของผู้ใช้)
    const targetSheet = ss.getSheetByName(blueprint.targetSheet);
    if (!targetSheet) {
      Logger.log(`ไม่พบชีตเป้าหมาย: ${blueprint.targetSheet}`);
      return { success: false, error: "ไม่พบชีตเป้าหมาย: " + blueprint.targetSheet };
    }
    
    const lastDataRow = targetSheet.getLastRow();
    
    // (ตรวจสอบว่ามีข้อมูลให้ฉีดสูตรหรือไม่)
    if (lastDataRow < blueprint.startRow) {
      Logger.log(`แถวสุดท้าย (${lastDataRow}) น้อยกว่าแถวเริ่มต้น (${blueprint.startRow})`);
      return { success: false, error: `ชีตเป้าหมาย "${blueprint.targetSheet}" ไม่มีข้อมูลให้ฉีดสูตร (แถวสุดท้าย: ${lastDataRow})` };
    }
    
    const numRowsToFill = (lastDataRow - blueprint.startRow) + 1;

    // 3. "ฉีดสูตร" (Lazy Script)
    // (สร้างช่วงเป้าหมาย เช่น "B2:B500")
    const targetRangeNotation = `${blueprint.targetCol}${blueprint.startRow}:${blueprint.targetCol}${lastDataRow}`;
    const targetRange = targetSheet.getRange(targetRangeNotation); 
    
    Logger.log(`กำลังฉีดสูตร "${formulaKey}" ลงใน "${blueprint.targetSheet}!${targetRangeNotation}"`);
    
    // (ใช้ setFormula() เพื่อให้สูตรปรับตัวเองอัตโนมัติ เช่น A2 -> A3, A4)
    targetRange.setFormula(blueprint.template); 

    return { success: true, message: `ฉีดสูตร "${formulaKey}" (จำนวน ${numRowsToFill} แถว) ลงในชีต "${blueprint.targetSheet}" สำเร็จ!` };

  } catch (e) {
    Logger.log(`[Formula Migrator] ล้มเหลว: ${e.message}`);
    Logger.log(e.stack);
    return { success: false, error: e.message };
  }
}
