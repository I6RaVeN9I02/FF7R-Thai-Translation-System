/**
 * ===========================================
 * "API" ที่ 1: ตัวควบคุม Build All (ไม่โต้ตอบ)
 * ===========================================
 */
function runFullWorkspace(ss) {
  Logger.log(`[Library API] เริ่ม "Build All" (โหมด Default)...`);
  
  try {
    // รัน MAIN (ด้วยโหมด 1)
    const mainResult = buildMainWsp(ss, 1);
    Logger.log(`[Library API] MAIN Build: ${mainResult.success ? 'สำเร็จ' : 'ล้มเหลว'}`);
    
    // รัน QST (ด้วยโหมด 1)
    const qstResult = buildQstWsp(ss, 1);
    Logger.log(`[Library API] QST Build: ${qstResult.success ? 'สำเร็จ' : 'ล้มเหลว'}`);

    // รัน NPC (ไม่มีโหมด)
    const npcResult = buildNpcWsp(ss);
    Logger.log(`[Library API] NPC Build: ${npcResult.success ? 'สำเร็จ' : 'ล้มเหลว'}`);

    // รัน ETC (ไม่มีโหมด)
    const etcResult = buildEtcWsp(ss);
    Logger.log(`[Library API] ETC Build: ${etcResult.success ? 'สำเร็จ' : 'ล้มเหลว'}`);

    Logger.log(`[Library API] "Build All" (โหมด Default) เสร็จสมบูรณ์!`);
    
    // คืนค่าผลลัพธ์รวม
    return {
      success: true,
      results: {
        main: mainResult,
        qst: qstResult,
        npc: npcResult,
        etc: etcResult
      }
    };
    
  } catch (e) {
    Logger.log(`[Library API] "Build All" ล้มเหลว: ${e.message}`);
    return { success: false, error: e.message };
  }
}


