 * =============================================================
 * File: WTP_V3_Module_QST.gs (Library Version)
 * (Beta V0.4.1 "Unified")
 *
 * V0.4.1_Lib-1 (Changelog):
 * - [ย้าย] มาเป็นไลบรารี "Translation Engine"
 * - [ผ่าตัด] ฟังก์ชัน `buildQstWsp_Beta_V0_4_1` ถูกเปลี่ยนชื่อเป็น `buildQstWsp`
 * - [ผ่าตัด] `SpreadsheetApp.getActiveSpreadsheet()` และ `getUi()` ถูกลบออก
 * - [ผ่าตัด] ฟังก์ชันรับ `ss` (Spreadsheet) และ `splitMode` (กฎการแบ่ง 1/2/3) เป็นพารามิเตอร์
 * - [ผ่าตัด] `ui.alert` ทั้งหมดถูกเปลี่ยนเป็น `Logger.log`
 * - [ผ่าตัด] `ui.prompt` สำหรับการเลือกโหมด ถูกถอดออกโดยสมบูรณ์
 * =============================================================
 */

function buildQstWsp(ss, splitMode = 1) { 
  Logger.log(`[QST Lib] เริ่มสร้างโมดูลเควส... (ได้รับ SplitMode = ${splitMode})`);

  try {
    // --- Phase 1: [V0.3] การเลือกโหมดการทำงาน (Smart Menu) ---
    // (ผ่าตัด `ui.prompt` ออกทั้งหมด ... ใช้ `splitMode` ที่รับค่ามาแทน)
    
    // (ตรวจสอบค่าที่รับมา ... หากผิดพลาด ให้ใช้โหมด 1)
    if (isNaN(splitMode) || splitMode < 1 || splitMode > 3) {
      Logger.log(`[QST Lib] ได้รับ SplitMode ไม่ถูกต้อง (${splitMode}), ปรับเป็นโหมด 1`);
      splitMode = 1;
    }

    // --- Phase 2: [V0.4.1] Super Scanner (เรียกใช้ V1.0 ส่วนกลาง) ---
    
    const lifeboatMap = new Map(); 
    const anchorMap = new Map();   
    
    const allPossibleSheets = [V3_QST_TARGET_COMBINED, V3_QST_MISC_SHEET]; 
    for (let i = 0; i <= V3_QST_MAX_COUNT; i++) { 
      allPossibleSheets.push(V3_QST_MODE2_PREFIX + i + V3_QST_MODE2_SUFFIX); 
    }
    for (let i = 1; i <= V3_QST_SMART_MAX_SHEETS; i++) { 
      allPossibleSheets.push(V3_QST_SMART_PREFIX + String.fromCharCode(64 + i) + V3_QST_SMART_SUFFIX);
    }
    const uniqueSheetsToScan = [...new Set(allPossibleSheets)]; 
    Logger.log(`[QST Lib] "Super Scanner" กำลังสแกน ${uniqueSheetsToScan.length} ชีตเป้าหมาย...`);

    for (const sheetName of uniqueSheetsToScan) {
      const v2Sheet = ss.getSheetByName(sheetName);
      if (v2Sheet && v2Sheet.getLastRow() > 0) {
        
        const v2Boundaries = findV2Boundaries_V1_0_UNIFIED(v2Sheet); 

        if (v2Boundaries) {
          const { 
            thColIdx, idColIdx, notesColIdx, fullIdColIdx, 
            data, headerRowIndex, scanMode 
          } = v2Boundaries;
          
          const startRow = (scanMode === "HEADER") ? headerRowIndex + 1 : 0;
          
          for (let i = startRow; i < data.length; i++) { 
            const row = data[i];
            
            if (row.length <= thColIdx) continue; 
            if (idColIdx !== -1 && row.length <= idColIdx) continue;
            
            const th = row[thColIdx] || "";
            const notes = (notesColIdx !== -1 && row.length > notesColIdx) ? (row[notesColIdx] || "") : "";
            
            if (th || notes) {
              if (idColIdx !== -1) {
                const idSpecial = row[idColIdx];
                if (idSpecial) {
                  lifeboatMap.set(idSpecial, { th: th, notes: notes });
                }
              }
              if (fullIdColIdx !== -1 && row.length > fullIdColIdx) {
                const fullId = row[fullIdColIdx];
                if (fullId) {
                  anchorMap.set(fullId, { th: th, notes: notes });
                }
              }
            }
          }
        }
      }
    }
    Logger.log(`[QST Lib] "Super Scanner" พบข้อมูล (C) ${lifeboatMap.size} รายการ และ (H) ${anchorMap.size} รายการ`);

    
    // --- Phase 3: Load & Group (V0.4n) ---
    // (ตรรกะ V0.4n "คงไว้" 100% ไม่มีการแก้ไข)
    const namesSheet = ss.getSheetByName(V3_NAMES_DICT);
    const namesData = namesSheet.getRange("A:C").getValues();
    const speakerNamesMap = new Map(); 
    for (const row of namesData) { if (row[0]) { speakerNamesMap.set(row[0], { us: row[1], enjp: row[2] }); } }
    const enjpSheet = ss.getSheetByName(V3_RAW_ENJP);
    const enjpData = enjpSheet.getRange("A:C").getValues();
    const enjpPivotMap = new Map();
    for (const row of enjpData) {
      const fullId = row[0]; const type = row[1]; const text = row[2]; if (!fullId) continue;
      if (!enjpPivotMap.has(fullId)) { enjpPivotMap.set(fullId, { actor: null, dialogue: null }); }
      let group = enjpPivotMap.get(fullId);
      if (type === "ACTOR") { group.actor = text; } else { group.dialogue = text; }
    }
    const jpSheet = ss.getSheetByName(V3_RAW_JP);
    const jpData = jpSheet.getRange("A:C").getValues(); 
    let dialogueGroups = new Map();
    for (const row of jpData) {
      const fullId = row[0]; const type = row[1]; const text = row[2]; if (!fullId) continue;
      if (!dialogueGroups.has(fullId)) {
        dialogueGroups.set(fullId, { fullId: fullId, actor: null, dialogue: null });
      }
      let group = dialogueGroups.get(fullId);
      if (type === "ACTOR") { group.actor = text; } 
      else { group.dialogue = text; }
    }
    const questGroupsMap = new Map(); 
    const miscBucket = [];
    const qstRegex = /_QST_(\d\d)_/i; 
    const qstGroupsRaw = Array.from(dialogueGroups.values())
        .filter(g => g.fullId.includes("_QST_") && g.dialogue);
    for (const group of qstGroupsRaw) {
      const fullId = group.fullId;
      const fidMatch = fullId.match(qstRegex);
      if (fidMatch) {
        const questNumber = fidMatch[1]; 
        if (!questGroupsMap.has(questNumber)) {
          questGroupsMap.set(questNumber, []);
        }
        questGroupsMap.get(questNumber).push(group); 
      } else {
        miscBucket.push(group);
      }
    }
    const sortedQuestNumbers = Array.from(questGroupsMap.keys()).sort((a, b) => a.localeCompare(b));
    
    // --- Phase 4: Build, Merge & [V0.4n Hybrid-Key] ---
    // (ตรรกะ V0.4n "คงไว้" 100% ไม่มีการแก้ไข)
    const output_QST_Combined = []; 
    const sheetConfigs = []; 
    const sheetNamesWritten = []; 
    const header = [
      ["ไอดีนำทาง (A)", "การแปลไทย (B)", "IDนำทางกำกับ (C)", "หมายเหตุ (D)", "Raw_JP (E)", "Raw_ENJP (F)", "ชื่อผู้พูด (G)", "Full ID (H)"]
    ];
    let smartSplitBucket = []; 
    let smartSplitSheetCounter = 1; 

    for (const questNumber of sortedQuestNumbers) {
      const questNumInt = parseInt(questNumber, 10); 
      const sheetName_Mode2 = V3_QST_MODE2_PREFIX + questNumInt + V3_QST_MODE2_SUFFIX; 
      const groupData = questGroupsMap.get(questNumber);
      const sheetOutputData_Mode2 = []; 
      groupData.sort((a, b) => a.fullId.localeCompare(b.fullId));
      let lineCounter = 1; 
      if (splitMode === 3) {
        if (smartSplitBucket.length > 0 && (smartSplitBucket.length + groupData.length > V3_QST_SMART_SPLIT_THRESHOLD)) {
          const sheetName = V3_QST_SMART_PREFIX + String.fromCharCode(64 + smartSplitSheetCounter++) + V3_QST_SMART_SUFFIX;
          sheetConfigs.push({ sheetName: sheetName, data: smartSplitBucket });
          smartSplitBucket = []; 
        }
      }
      for (const group of groupData) {
        const fullId_H = group.fullId; const jpText_E = group.dialogue;
        const enjpGroup = enjpPivotMap.get(fullId_H) || { dialogue: "" };
        const enjpText_F = enjpGroup.dialogue;
        const speakerInfo = speakerNamesMap.get(group.actor) || { jp: group.actor, us: group.actor, enjp: null };
        const enjpActor = speakerInfo.enjp || (enjpPivotMap.get(fullId_H) ? enjpPivotMap.get(fullId_H).actor : null) || speakerInfo.us;
        const speakerNames_G = [speakerInfo.jp, speakerInfo.us, enjpActor].filter(Boolean).join(" / ");
        const potentialId = "q" + questNumInt + "-" + String(lineCounter++).padStart(2, "0");
        const oldData = lifeboatMap.get(potentialId) || anchorMap.get(fullId_H) || { th: "", notes: "" };
        const translation_B = oldData.th; const notes_D = oldData.notes;
        const speakerName_Part1 = enjpActor || speakerInfo.us || speakerInfo.jp || "???"; 
        const idCode_Part2 = fullId_H.slice(-3); 
        const final_displayId_A = `${speakerName_Part1} , ${idCode_Part2} , ${potentialId}`;
        const specialId_C = (translation_B || notes_D) ? potentialId : ""; 
        const newRow = [
             final_displayId_A, translation_B, specialId_C, notes_D,
             jpText_E, enjpText_F, speakerNames_G, fullId_H
        ];
        output_QST_Combined.push(newRow); 
        sheetOutputData_Mode2.push(newRow); 
      }
      if (splitMode === 2) {
        sheetConfigs.push({ sheetName: sheetName_Mode2, data: sheetOutputData_Mode2 });
        sheetNamesWritten.push(sheetName_Mode2);
      }
      if (splitMode === 3) {
        smartSplitBucket = smartSplitBucket.concat(sheetOutputData_Mode2); 
      }
    }
    
    // 4.4: ประมวลผลกลุ่ม "MISC" (V0.4n ... "คงไว้" 100%)
    const miscOutputData = [];
    miscBucket.sort((a, b) => a.fullId.localeCompare(b.fullId));
    let miscLineCounter = 1; 
    for (const group of miscBucket) {
        const fullId_H = group.fullId; const jpText_E = group.dialogue;
        const enjpGroup = enjpPivotMap.get(fullId_H) || { dialogue: "" };
        const enjpText_F = enjpGroup.dialogue;
        const speakerInfo = speakerNamesMap.get(group.actor) || { jp: group.actor, us: group.actor, enjp: null };
        const enjpActor = speakerInfo.enjp || (enjpPivotMap.get(fullId_H) ? enjpPivotMap.get(fullId_H).actor : null) || speakerInfo.us;
        const speakerNames_G = [speakerInfo.jp, speakerInfo.us, enjpActor].filter(Boolean).join(" / ");
        const potentialId = "qMISC-" + String(miscLineCounter++).padStart(4, "0"); 
        const oldData = lifeboatMap.get(potentialId) || anchorMap.get(fullId_H) || { th: "", notes: "" };
        const translation_B = oldData.th; const notes_D = oldData.notes;
        const speakerName_Part1 = enjpActor || speakerInfo.us || speakerInfo.jp || "???"; 
        const idCode_Part2 = fullId_H.slice(-3); 
        const final_displayId_A = `${speakerName_Part1} , ${idCode_Part2} , ${potentialId}`;
        const specialId_C = (translation_B || notes_D) ? potentialId : ""; 
        const newRow = [
             final_displayId_A, translation_B, specialId_C, notes_D,
             jpText_E, enjpText_F, speakerNames_G, fullId_H
        ];
        output_QST_Combined.push(newRow);
        miscOutputData.push(newRow);
    }
    
    // --- Phase 5: [V0.3] "Dynamic Write" & "Smart Cleanup" ---
    // (ตรรกะ V0.3-FIX3 ... "คงไว้" 100% ไม่มีการแก้ไข)
    let totalRowsWritten = 0;
    let finalSheetConfigs = [];
    let finalSheetNamesWritten = [];
    if (splitMode === 1) {
      finalSheetConfigs = [{ sheetName: V3_QST_TARGET_COMBINED, data: output_QST_Combined }];
      finalSheetNamesWritten = [V3_QST_TARGET_COMBINED];
    } 
    else if (splitMode === 2) {
      if (miscOutputData.length > 0) {
         sheetConfigs.push({ sheetName: V3_QST_MISC_SHEET, data: miscOutputData });
         sheetNamesWritten.push(V3_QST_MISC_SHEET);
      }
      finalSheetConfigs = sheetConfigs; 
      finalSheetNamesWritten = sheetNamesWritten;
    }
    else {
      if (miscOutputData.length > 0) {
        smartSplitBucket = smartSplitBucket.concat(miscOutputData);
      }
      if (smartSplitBucket.length > 0) {
        if (sheetConfigs.length > 0 && smartSplitBucket.length < V3_QST_SMART_SPLIT_MINIMUM) {
          const lastConfig = sheetConfigs[sheetConfigs.length - 1];
          lastConfig.data = lastConfig.data.concat(smartSplitBucket);
        } else {
          const sheetName = V3_QST_SMART_PREFIX + String.fromCharCode(64 + smartSplitSheetCounter++) + V3_QST_SMART_SUFFIX;
          sheetConfigs.push({ sheetName: sheetName, data: smartSplitBucket });
        }
      }
      finalSheetConfigs = sheetConfigs;
      finalSheetNamesWritten = sheetConfigs.map(config => config.sheetName);
    }
    for (const config of finalSheetConfigs) {
      if (config.data.length === 0) continue; 
      let targetSheet = ss.getSheetByName(config.sheetName);
      if (!targetSheet) {
        targetSheet = ss.insertSheet(config.sheetName);
      }
      targetSheet.clear();
      const fullOutput = header.concat(config.data);
      targetSheet.getRange(4, 1, fullOutput.length, 8).setValues(fullOutput);
      totalRowsWritten += config.data.length;
    }
    const uniqueSheetsToCleanup = uniqueSheetsToScan; 
    for (const sheetName of uniqueSheetsToCleanup) {
      if (!finalSheetNamesWritten.includes(sheetName)) {
        const oldSheet = ss.getSheetByName(sheetName);
        if (oldSheet) {
          ss.deleteSheet(oldSheet); 
        }
      }
    }
    let modeText = "N/A";
    if (splitMode === 1) modeText = `โหมด "รวม"`;
    else if (splitMode === 2) modeText = `โหมด "แยกย่อย" (Qx_WSP)`;
    else modeText = `โหมด "Smart Split" (QST_x_WSP)`;

    const finalSheetNames = finalSheetNamesWritten.length > 0 ? finalSheetNamesWritten.join(', ') : "ไม่พบข้อมูล";
    
    Logger.log(`[QST Lib] สร้างโมดูลเควสเสร็จสมบูรณ์!\n(${modeText})\n\n` +
             `- สร้างข้อมูลนิ่ง ${totalRowsWritten} แถว\n` +
             `- ลงใน ${finalSheetNamesWritten.length} ชีต (${finalSheetNames})\n` +
             `- ผสานข้อมูลแปลเดิม (C) ${lifeboatMap.size} + (H) ${anchorMap.size} รายการ`);
    
    // (คืนค่าผลลัพธ์ให้ตัวเรียกใช้ ... เผื่อใช้ในอนาคต)
    return {
      success: true,
      mode: modeText,
      rowsWritten: totalRowsWritten,
      sheets: finalSheetNamesWritten,
      cKeyCount: lifeboatMap.size,
      hKeyCount: anchorMap.size
    };

  } catch (e) {
    Logger.log(`[QST Lib] เกิดข้อผิดพลาดร้ายแรง: ${e.message}`);
    // (คืนค่าผลลัพธ์แบบล้มเหลว)
    return {
      success: false,
      error: e.message
    };
  }
}
