=ARRAYFORMULA(
   LET(
      jp_ids, JP!A:A,
      jp_types, JP!B:B,
      jp_texts, JP!C:C,
      
      translated_texts, 
         IF(jp_ids="", "",
            IF(jp_types = "ACTOR",
               IFERROR(VLOOKUP(jp_texts, Names_JP_TH_EN!A:C, 3, FALSE), jp_texts),
               IFERROR(VLOOKUP(jp_ids, Master_Data_Hub!A:F, 6, FALSE), jp_texts)
            )
         ),
         
      {jp_ids, jp_types, translated_texts}
   )
)
